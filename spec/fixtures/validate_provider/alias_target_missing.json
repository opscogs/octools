        "description": "Return the cluster identity and versions. Use it before any other call.",
        "input_schema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "output_schema": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string"
            }
          },
          "required": ["version"],
          "additionalProperties": false
        },
        "access": "remote",
        "deprecated": true,
        "meta": {
          "alias_of": "cluster_info_v2"
        }
      }
    ]
  },
  "expected": [
