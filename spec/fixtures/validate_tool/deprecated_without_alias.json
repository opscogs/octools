{
  "description": "A deprecated tool must name its replacement in meta.alias_of.",
  "input": {
    "tool": {
      "name": "cluster_info",
      "description": "Return the cluster identity and versions. Use it before any other call.",
      "input_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          }
        },
        "required": ["version"],
        "additionalProperties": false
      },
      "access": "remote",
      "deprecated": true
    }
  },
  "expected": [
    {
      "rule": "deprecated_alias",
      "tool": "cluster_info",
      "path": null
    }
  ]
}
